# dkit-light: default look and feel for dkit.plot2
#
# NOTE: in .mplstyle files '#' starts a comment, so colours are written
#       WITHOUT the leading '#' (05386E, not #05386E).
#
# Reference for all valid keys:
#   python -c "import matplotlib; print(matplotlib.matplotlib_fname())"

figure.figsize:         6.30, 2.76      # 16cm x 7cm
figure.dpi:             96
figure.facecolor:       white
figure.titlesize:       large

savefig.bbox:           tight
savefig.facecolor:      white
savefig.transparent:    False

font.family:            sans-serif
font.size:              9

axes.facecolor:         white
axes.edgecolor:         4d4d4d
axes.labelcolor:        1a1a1a
axes.linewidth:         0.5
axes.titlesize:         medium
axes.titleweight:       bold
axes.titlelocation:     left
axes.titlepad:          8.0
axes.labelsize:         small
axes.spines.top:        False
axes.spines.right:      False
axes.grid:              True
axes.grid.axis:         y
axes.axisbelow:         True
axes.prop_cycle:        cycler('color', ['05386E', '00a9e0', '0047bb', '008fd5', 'fc4f30', 'e5ae38'])

grid.color:             b0b0b0
grid.linewidth:         0.4
grid.alpha:             0.5

xtick.labelsize:        x-small
ytick.labelsize:        x-small
xtick.color:            4d4d4d
ytick.color:            4d4d4d
xtick.direction:        out
ytick.direction:        out
xtick.major.width:      0.5
ytick.major.width:      0.5
xtick.major.size:       3.0
ytick.major.size:       3.0

lines.linewidth:        1.25
lines.markersize:       4.0

# the frame is on, but invisible: no edge, and a facecolor inherited from the
# axes.  A frameless legend that lands over the data is unreadable, and 'best'
# lands there often; this keeps the clean look and still masks what is behind.
legend.frameon:         True
legend.facecolor:       inherit
legend.edgecolor:       none
legend.framealpha:      0.85
legend.fontsize:        x-small

image.cmap:             viridis
